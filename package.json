{
  "name": "@geo318/safe-calc",
  "version": "2.0.0",
  "description": "Zero-dependency decimal arithmetic, explicit rounding, and precision-safe currency formatting for JavaScript and TypeScript.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./prototype": {
      "import": {
        "types": "./dist/esm/prototype.d.ts",
        "default": "./dist/esm/prototype.js"
      },
      "require": {
        "types": "./dist/cjs/prototype.d.ts",
        "default": "./dist/cjs/prototype.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/esm/prototype.js",
    "./dist/cjs/prototype.js"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json",
    "tsc": "npm run typecheck",
    "tests": "npm run check",
    "check": "npm run build && npm run typecheck && node --test test/*.test.mjs && npm run test:package",
    "test:package": "node scripts/check-package.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "test:reference": "node scripts/reference.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geo318/js-calc-extension.git"
  },
  "homepage": "https://github.com/geo318/js-calc-extension#readme",
  "bugs": {
    "url": "https://github.com/geo318/js-calc-extension/issues"
  },
  "keywords": [
    "decimal",
    "math",
    "arithmetic",
    "rounding",
    "currency",
    "money",
    "bigint",
    "typescript",
    "precision",
    "zero-dependency"
  ],
  "author": "geo318",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
