{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "ES2023.Intl"],
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "declaration": true, "declarationMap": false, "sourceMap": false,
    "skipLibCheck": false, "forceConsistentCasingInFileNames": true,
    "rootDir": "src", "outDir": "dist/esm"
  },
  "include": ["src/**/*.ts"]
}
